# ==============================================================================
# SAHYOG AI — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your local credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DATABASE_URL=file:./dev.db

# MQTT Broker Configuration (for Multi-Device IoT Fleet)
MQTT_SERVER=broker.hivemq.com
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# AI & LLM Services (Optional — demo engine operates offline by default)
AI_API_KEY=
AI_API_ENDPOINT=

# Frontend Configuration (for frontend/.env)
VITE_SOCKET_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001/api
